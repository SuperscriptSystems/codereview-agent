{
	"$schema": "https://opencode.ai/config.json",
	"model": "openai/gpt-5.5",
	"small_model": "openai/gpt-5.4-mini",
	"provider": {
		"openai": {
			"options": {
				"apiKey": "{env:OPENAI_API_KEY}",
				"baseURL": "https://clb.firsttouch.ai/v1"
			}
		}
	},
	"agent": {
		"reviewer": {
			"description": "Reviews changed code for concrete bugs and risks",
			"mode": "all",
			"temperature": 0.1,
			"prompt": "{file:./prompts/reviewer.md}",
			"permission": {
				"edit": "deny",
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"bash": {
					"*": "deny",
					"git diff*": "allow",
					"git log*": "allow",
					"git show*": "allow",
					"git status*": "allow",
					"git rev-parse*": "allow"
				}
			}
		},
		"context-builder": {
			"description": "Determines the minimal sufficient review context",
			"mode": "all",
			"temperature": 0.1,
			"prompt": "{file:./prompts/context-builder.md}",
			"permission": {
				"edit": "deny",
				"bash": "deny",
				"read": "allow",
				"glob": "allow",
				"grep": "allow"
			}
		},
		"summarizer": {
			"description": "Summarizes change impact for Jira assessment",
			"mode": "all",
			"temperature": 0.1,
			"prompt": "{file:./prompts/summarizer.md}",
			"permission": {
				"edit": "deny",
				"bash": "deny",
				"read": "allow",
				"glob": "allow",
				"grep": "allow"
			}
		}
	}
}
